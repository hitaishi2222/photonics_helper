**/pdf_images/
**/paper_pages/

nk_datasets/yaml/

# Generated mkdocs site (built/deployed by .github/workflows/docs.yml)
site/

# Reproduction reprints & rendered page images (local only, do not commit)
reproductions/**/*.pdf
reproductions/planned/**/pages/
# Reproduction run logs are not committed — except the two that reproduction
# READMEs cite as recorded provenance.
reproductions/**/*.log
!reproductions/heidt_2009_adaptive_step/full_validate.log
!reproductions/krupa_2019_multimode/krupa_test.log
